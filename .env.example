# Copy to .env for local development. Never commit .env.
ENV=dev
LOG_LEVEL=INFO
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://el:el@127.0.0.1:5432/el_dev
# Optional locally (a dev-only default is used); required in staging and production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# External services. "fake" runs the whole pipeline offline on synthetic data; "real" calls the actual services and
# needs the keys below. Never commit real keys.
PROVIDERS=fake
# ANTHROPIC_API_KEY=
# APIFY_TOKEN=
# APOLLO_API_KEY=
# RESEND_API_KEY=
# REOON_ENABLED=false
# REOON_API_KEY=
# CLASSIFY_MODEL=claude-opus-5-5   # claude-haiku-5-5 costs about 1/40 as much

# Spend caps in US dollars for Apify and Claude (defaults shown).
# RUN_BUDGET_USD=3.00
# ANALYSIS_BUDGET_USD=0.50
# DAILY_CAP_USD=20.00

# LinkedIn post search (defaults shown). A search for the same event within SEARCH_CACHE_DAYS is reused, not rerun.
# SEARCH_POSTS_PER_QUERY=50
# SEARCH_CACHE_DAYS=3
# SEARCH_POLL_SECONDS=20

# Finding emails and delivering the list (defaults shown). Apollo bills a credit per person it finds. A person's
# Apollo data and email check are reused for PERSON_CACHE_DAYS (at most 30: personal data is deleted after 30 days).
# MAX_LEADS=50
# APOLLO_CREDITS_PER_RUN=150
# PERSON_CACHE_DAYS=30
# ACCEPTED_EMAIL_STATUSES=verified   # comma-separated Apollo email statuses
# MIN_ICP_SCORE=40
# RESULTS_DAYS=30
